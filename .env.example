# Copy to .env (gitignored). Never commit real values.

# ---- Local rehearsal / public testnet wallets ----
# One BIP-39 phrase; Hardhat derives 12 accounts at m/44'/60'/0'/0/N.
# Index N is the same ROLE on every network (see docs/TESTNET_DEMO.md):
#   0 platform owner + deployer   1 fee wallet / compliance officer
#   2 KYC issuer                  3 AML issuer
#   4 risk oracle                 5 fraud oracle
#   6-8 investors                 9 deliberately unverified user
# Generate a fresh one: npx hardhat run scripts/print-role-wallets.js --network hardhat
MNEMONIC=

# ---- Sepolia ----
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# Governance time scale for the demo's VanguardGovernance deploy.
# 1 = mainnet schedule (7-day votes). 336 = 30-minute votes, ~9-minute delay.
# Max 1440 (7-minute votes, 1-minute delay): beyond that a delay floors to 0s.
# Read by demo/modules/GovernanceModule.js at deploy time.
GOV_TIME_SCALE=1
