# Copy to .env (gitignored). Never commit real values.

# ---- Demo and local rehearsal wallets ----
# One BIP-39 phrase; Hardhat derives 12 accounts at m/44'/60'/0'/0/N.
# Index N is the same ROLE on every network (see docs/TESTNET_SETUP.md):
#   0 platform owner + deployer   1 fee wallet / compliance officer
#   2 KYC issuer                  3 AML issuer
#   4 risk oracle                 5 fraud oracle
#   6-8 investors                 9 deliberately unverified user
# Generate a fresh one: npx hardhat run scripts/print-role-wallets.js --network hardhat
# For the demo menu and a local rehearsal only. The production deploy and
# the ceremony CLIs refuse MNEMONIC / PRIVATE_KEY off a local dev chain
# (31337): on Sepolia every key lives in the external signer below
# (docs/OPERATOR_RUNBOOK.md). The published Hardhat phrase is refused on
# any chain but 31337.
MNEMONIC=

# ---- Sepolia ----
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# ---- External signer (scripts/production/signer.js) ----
# The CLIs reach it as --network remote; it holds the keys (encrypted
# keystores, one per role, ordered by file name: handover.json pins each
# wallet index to its address) and forwards reads to SIGNER_UPSTREAM.
# e.g. http://127.0.0.1:1248 (the signer's default port)
SIGNER_RPC_URL=
# Bearer token file (0600; default /tmp/vanguard-signer-<uid>/<port>.token),
# written by the signer at start and removed when it exits.
SIGNER_TOKEN_FILE=
# The signer's own settings (its process, not the CLIs'):
SIGNER_UPSTREAM=
SIGNER_KEYSTORE_DIR=
# The keystore password, from a 0600 file (never a variable holding it).
SIGNER_PASSWORD_FILE=
# Unset: every request is asked on the terminal off 31337 (the default);
# 0 switches that off with a warning; 1 asks on 31337 too.
SIGNER_PROMPT=

# ---- ZK CLIs (scripts/zk/*.js): the RPC URL, never argv ----
ZK_RPC_URL=

# Governance time scale for the demo's VanguardGovernance deploy.
# 1 = mainnet schedule (7-day votes). 336 = 30-minute votes, ~9-minute delay.
# Max 1440 (7-minute votes, 1-minute delay): beyond that a delay floors to 0s.
# Read by demo/modules/GovernanceModule.js at deploy time.
GOV_TIME_SCALE=1
