# Copy to .env (gitignored). Never commit real values.
# Hardhat loads .env into every run: leave the per-run variables at the
# bottom commented out and set them on the command line instead.

# ---- Demo and local rehearsal wallets ----
# One BIP-39 phrase; Hardhat derives 12 accounts at m/44'/60'/0'/0/N.
# Index N is the same ROLE wherever the demo runs (docs/TESTNET_SETUP.md,
# scripts/print-role-wallets.js):
#   0 deployer, platform owner      1 fee wallet, compliance officer, KYC oracle node
#   2 AML oracle node               3 compliance oracle node
#   4, 5 onboarded users            6, 7, 8 investors (Alice, Bob, Carol)
#   9 issuer admin (unverified)     10 ops                11 guardian
# Generate a fresh one: npx hardhat run scripts/print-role-wallets.js --network hardhat
# For the demo menu and a local rehearsal only. The production deploy
# refuses MNEMONIC / PRIVATE_KEY off a local dev chain (31337): on Sepolia
# every key lives in the external signer below (docs/OPERATOR_RUNBOOK.md).
# hardhat.config.ts refuses the published Hardhat phrase on any chain but
# 31337.
MNEMONIC=

# ---- Sepolia ----
# Used only by `--network sepolia` (not by the production path, which runs
# on --network remote through the signer).
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# ---- External signer (scripts/production/signer.js) ----
# The CLIs reach it as --network remote; it holds the keys (encrypted
# keystores, one per key, ordered by file name: handover.json pins each
# wallet index to its address) and forwards reads to SIGNER_UPSTREAM.
# e.g. http://127.0.0.1:1248 (the signer's default port)
SIGNER_RPC_URL=
# Bearer token file (0600; default <tmp>/vanguard-signer-<uid>/<port>.token),
# written by the signer at start and removed when it exits; the signed
# nonces are kept beside it (<token file>.signed.json).
SIGNER_TOKEN_FILE=
# The signer's own settings (its process, not the CLIs'). The upstream URL
# carries the provider key: export it from a 0600 file, never type it.
SIGNER_UPSTREAM=
SIGNER_KEYSTORE_DIR=
# The keystore password, from a 0600 file (never a variable holding it).
SIGNER_PASSWORD_FILE=
# Unset: every request is asked on the terminal off 31337 (the default);
# 0 switches that off with a warning; 1 asks on 31337 too.
SIGNER_PROMPT=
# Optional: where the prompt reads compiled ABIs (default artifacts/contracts).
SIGNER_ABI_DIR=
# SIGNER_TEST=1 lets signer.js serve chain 31337 (the CI drives only).
# scripts/ci/remote-signer.js is CI tooling (keys from MNEMONIC; its
# SIGNER_ALLOW_CHAIN guard): never run it with a real key.

# ---- RPC URLs for the checks: a 0600 file each, never argv ----
# RPC_CHECK_URLS_FILE=   (rpcCheck.js; or RPC_CHECK_URLS)
# COST_RPC_URL_FILE=     (costTable.js measure; or COST_RPC_URL)
# SCAN_RPC_URLS=         (scanCount.ts: export it from a 0600 file)

# ---- ZK CLIs (scripts/zk/*.js): URL and keys from 0600 files ----
# ZK_RPC_URL_FILE=   (or ZK_RPC_URL; --rpc is refused)
# ATTESTOR_KEY_FILE=         (or ATTESTOR_KEY; attest.js)
# WHITELIST_OPS_KEY_FILE=    (or WHITELIST_OPS_KEY; build-whitelist-root.js --publish)
# WHITELIST_WALLET_KEY_FILE= (or WHITELIST_WALLET_KEY; the provers' --submit)
# WHITELIST_SECRET=          (prove-whitelist.js; prefer --secret-file)

# ---- Per-run variables of the production CLIs (set them per command) ----
# DEPLOY_CONFIG=     deploy inputs (DeployProduction.ts)
# DEPLOY_RECORD=     default deployments/<chainId>.json
# HANDOVER_CONFIG=   default deployments/<chainId>.handover.json (deploy)
# OPS_IDENTITY=      the ops OnchainID for KeyManager (deploy)
# HANDOVER_PHASE=    unset/full, preflight, accept, audit (handover.ts)
# HANDOVER_SNAPSHOT_SHA256=  the full phase's printed digest (accept)
# VOTER_VGT=         VGT per voter, default 1000 (onboardVoters.ts)
# NEW_NODES=         0xA:NAME,0xB:NAME (postCeremonyVotes.ts)
# CLAIM_SIGNERS=     kyc:0xA,aml:0xB (claimSigners.ts)
# SCAN_CHUNKS=       logChunk sizes, default 5000,1000 (scanCount.ts)

# Governance time scale for the demo's VanguardGovernance deploy, a
# dev-chain knob (the production deploy refuses any value but 1 off a dev
# chain). 1 = mainnet schedule (7-day votes, 2-day delay). 336 = 30-minute
# votes, ~9-minute delay. Max 1440 (7-minute votes, 120 s delay: 2 days /
# 1440); the contract refuses more (TimeScaleOutOfRange).
# Read by demo/utils/GovernanceDeployFlow.js at deploy time.
GOV_TIME_SCALE=1
